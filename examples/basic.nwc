#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char *name;
    int fuel_cost;
    int crystals;
    int visited;
} Planet;

int fuel = 100;
int crystals = 0;
int current = 0;

Planet planets[3] = {
    {"Kepler-22", 15, 3, 0},
    {"Nova-7", 25, 5, 0},
    {"Titan", 35, 8, 0}
};

void status(void) {
    printf("\n--- SHIP STATUS ---\n");
    printf("Fuel: %d\n", fuel);
    printf("Crystals: %d\n", crystals);
    printf("Location: %s\n",
           current == -1 ? "Earth" : planets[current].name);
}

void explore(int id) {
    if (fuel < planets[id].fuel_cost) {
        printf("\nNot enough fuel!\n");
        return;
    }

    fuel -= planets[id].fuel_cost;
    current = id;

    printf("\nLanding on %s...\n", planets[id].name);

    if (!planets[id].visited) {
        planets[id].visited = 1;
        crystals += planets[id].crystals;

        printf("Planet explored!\n");
        printf("Found %d crystals!\n",
               planets[id].crystals);
    } else {
        printf("Nothing new to discover.\n");
    }
}

void refuel(void) {
    if (current != -1) {
        printf("\nYou must return to Earth to refuel.\n");
        return;
    }

    fuel += 30;
    if (fuel > 100) fuel = 100;

    printf("\nShip refueled!\n");
}

int main(void) {
    int choice;
    int running = 1;

    printf("========================\n");
    printf("       STARBOUND        \n");
    printf("========================\n");
    printf("Mission: Explore 3 planets.\n");
    printf("Collect at least 10 crystals.\n");
    printf("Return safely to Earth.\n");

    while (running) {
        status();

        printf("\n--- COMMAND CENTER ---\n");
        printf("1. Explore Kepler-22\n");
        printf("2. Explore Nova-7\n");
        printf("3. Explore Titan\n");
        printf("4. Return to Earth\n");
        printf("5. Refuel\n");
        printf("0. Quit\n");
        printf("Command: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input.\n");
            break;
        }

        switch (choice) {
            case 1:
                explore(0);
                break;

            case 2:
                explore(1);
                break;

            case 3:
                explore(2);
                break;

            case 4:
                current = -1;
                printf("\nReturning to Earth...\n");
                break;

            case 5:
                refuel();
                break;

            case 0:
                running = 0;
                break;

            default:
                printf("Unknown command.\n");
                break;
        }

        if (current == -1 &&
            planets[0].visited &&
            planets[1].visited &&
            planets[2].visited) {

            printf("\nMISSION COMPLETE!\n");
            printf("Total crystals: %d\n", crystals);

            if (crystals >= 10)
                printf("Excellent exploration!\n");
            else
                printf("More crystals were needed.\n");

            running = 0;
        }
    }

    printf("\nMission terminated.\n");
    return 0;
}


